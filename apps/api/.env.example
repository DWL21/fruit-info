# 이름과 설명만 둔다. 실제 값은 서버 /etc/fruit-info/api.env 에만 저장한다.
PORT=8787
# SQLite·사진 저장 폴더
DATA_DIR=./data
# 공개 주소 (사진 URL 생성용)
PUBLIC_URL=http://localhost:8787
# 허용할 웹 출처 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173
# 운영자 촬영 모드 키 (서버에서 openssl rand -hex 24 로 생성)
UPLOAD_KEY=
# 분석기: codex | mock
ANALYZER=mock
CODEX_BIN=codex
CODEX_MODEL=gpt-6.1-sol
ANALYZE_CONCURRENCY=2
# 에러 추적 (없으면 비활성)
SENTRY_DSN=
